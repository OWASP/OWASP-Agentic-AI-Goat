# Native-only feasibility; no installed entrypoint or trusted completion.
# Separate unqualified invocation image. Discovery image/entrypoint unchanged.
FROM node:26.10.0-slim@sha256:ec7758ee051e457b468b32bde57b0879010b325bb9862718e9615225ce4aaae1 AS build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev libseccomp-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY sidecars/sandbox-runner/owned-mcp-registry/package.json sidecars/sandbox-runner/owned-mcp-registry/package-lock.json ./
RUN --mount=type=secret,id=npm_ca if [ -f /run/secrets/npm_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/npm_ca; fi; npm ci --ignore-scripts --no-audit --no-fund
COPY sidecars/sandbox-runner/owned-mcp-registry /source/sidecars/sandbox-runner/owned-mcp-registry
COPY server/services /source/server/services
COPY sidecars/sandbox-runner/mcpSeccompFilter.c /build/
RUN mkdir /out \
 && gcc -O2 -Wall -Wextra -Werror /source/sidecars/sandbox-runner/owned-mcp-registry/invocation-supervisor.c -o /out/dvaia-invocation-supervisor \
 && gcc -O2 -Wall -Wextra -Werror /source/sidecars/sandbox-runner/owned-mcp-registry/procless-feasibility.c -o /out/dvaia-procless-feasibility \
 && gcc -O2 -Wall -Wextra -Werror /source/sidecars/sandbox-runner/owned-mcp-registry/invocation-bootstrap.c -o /out/dvaia-invocation-bootstrap \
 && gcc -O2 -Wall -Wextra -Werror -shared -fPIC -DNODE_GYP_MODULE_NAME=dvaia_invocation_peer -I/usr/local/include/node /source/sidecars/sandbox-runner/owned-mcp-registry/invocation-peer.c -o /out/dvaia-invocation-peer.node \
 && gcc -O2 -Wall -Wextra -Werror mcpSeccompFilter.c -lseccomp -o /tmp/filter && /tmp/filter /out/invocation-target.seccomp.bpf \
 && NODE_PATH=/build/node_modules ./node_modules/.bin/esbuild /source/sidecars/sandbox-runner/owned-mcp-registry/invocation-worker.js --bundle --platform=node --format=cjs --outfile=/out/dvaia-invocation-worker.js \
 && NODE_PATH=/build/node_modules ./node_modules/.bin/esbuild /source/sidecars/sandbox-runner/owned-mcp-registry/invocation-listener.js --bundle --platform=node --format=cjs --external:/usr/local/libexec/dvaia-invocation-peer.node --outfile=/out/invocation-listener.js
FROM node:26.10.0-slim@sha256:ec7758ee051e457b468b32bde57b0879010b325bb9862718e9615225ce4aaae1
RUN test "$(dpkg --print-architecture)" = arm64 && apt-get update && apt-get install -y --no-install-recommends bubblewrap libseccomp2 && rm -rf /var/lib/apt/lists/* && mkdir -p /usr/share/dvaia /usr/local/libexec /app/sidecars/sandbox-runner/owned-mcp-registry
COPY --from=build /out/dvaia-procless-feasibility /usr/local/libexec/
COPY --from=build /out/dvaia-invocation-supervisor /out/dvaia-invocation-bootstrap /out/dvaia-invocation-peer.node /out/dvaia-invocation-worker.js /usr/local/libexec/
COPY --from=build /out/invocation-listener.js /app/sidecars/sandbox-runner/owned-mcp-registry/invocation-listener.js
COPY --from=build /out/invocation-target.seccomp.bpf /usr/share/dvaia/invocation-target.seccomp.bpf
COPY --chmod=0444 sidecars/sandbox-runner/owned-mcp-registry/invocation-build-assets.js /app/invocation-build-assets.js
RUN node /app/invocation-build-assets.js && chmod 0555 /app /app/sidecars /app/sidecars/sandbox-runner /app/sidecars/sandbox-runner/owned-mcp-registry
RUN chmod 0555 /usr/local/libexec/dvaia-procless-feasibility && sha256sum /usr/local/libexec/dvaia-procless-feasibility > /usr/share/dvaia/procless-feasibility.sha256 && chmod 0444 /usr/share/dvaia/procless-feasibility.sha256
USER 10001:10001
RUN node -e "const fs=require('node:fs');const a=require('/app/invocation-build-assets');a.verify();for(const p of a.ASSETS)fs.accessSync(p,fs.constants.R_OK);fs.accessSync('/usr/local/libexec/dvaia-invocation-supervisor',fs.constants.X_OK)"
EXPOSE 8095
# Three nonsecret expected identity arguments are mandatory. Mount only reviewed
# private state/secrets and an owned0700 /run/dvaia-invocation tmpfs. Native plan
# must retain readonly root, profile, capabilities and isolated network policy.
ENTRYPOINT ["/usr/local/libexec/dvaia-procless-feasibility", "--probe"]
