# =============================================================================
# DVAIA Environment Configuration Example
# =============================================================================
# Copy this to .env and fill in your values.
# Local dev  → AI_PROVIDER=ollama (default)
# Optional AWS Bedrock provider → AI_PROVIDER=bedrock with your own SDK credentials

# ===========================================
# AI PROVIDER SELECTION
# ===========================================
# Local development: ollama
# Optional cloud provider: bedrock with your own AWS SDK credentials
AI_PROVIDER=ollama   # ollama | bedrock | claude | chatgpt

# ===========================================
# OLLAMA — Local LLM (default for local dev)
# ===========================================
# Install: https://ollama.ai/download  |  Run: ollama serve
# Pull model: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Per-process shared endpoint budget for actor and Judge requests.
AI_OLLAMA_CONCURRENCY=2
AI_OLLAMA_QUEUE_LIMIT=256
# Waiting requests per owner, per process/endpoint (active calls excluded).
AI_OLLAMA_OWNER_QUEUE_LIMIT=16

# Fresh setup stores and verifies the document embedding model in its private cache.
# Existing installs can set an absolute path prepared by scripts/verify-embedding-runtime.js.
XENOVA_CACHE=
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
# Better local quality (requires more RAM): qwen2.5-coder:32b-instruct-fp16
# OLLAMA_MODEL=qwen2.5-coder:32b-instruct-fp16
# Unspecified Ollama context uses 8192; explicitly raise only for a qualified workload.
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_MAX_TOKENS=4096
OLLAMA_TEMPERATURE=0.7

# Objective grading: local LangChain/LangGraph judge, no API key required.
JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama3.1:8b
# Must fit full evidence + grading instructions; too-small contexts are rejected.
JUDGE_CONTEXT_TOKENS=32768
# Ordinary audit summary: whole owner run (including actor) and aggregate Judge
# deadlines. Defaults preserve current behavior; opt-in limits are 290000/240000.
# Leave at defaults until the selected model is qualified for this objective.
SS_AUDIT_RUN_TIMEOUT_MS=120000
SS_AUDIT_JUDGE_TIMEOUT_MS=90000
# Unbounded-audit lesson only: whole run, including its existing 90000 ms Judge
# cap and reserved post-processing time. Accepted range: 125000–290000 ms.
# This bounded runtime allowance does not establish model/lesson qualification.
SS_AUDIT_UNBOUNDED_RUN_TIMEOUT_MS=290000

# ===========================================
# AWS BEDROCK — Optional model provider
# ===========================================
# Set AI_PROVIDER=bedrock only with a configured AWS SDK credential source.
# The application does not provision or deploy AWS infrastructure.
BEDROCK_MODEL_ID=us.meta.llama3-1-8b-instruct-v1:0
BEDROCK_REGION=us-west-2

# ===========================================
# CLAUDE API (Anthropic)
# ===========================================
# Get API key: https://console.anthropic.com/
# CLAUDE_API_KEY=your_claude_api_key_here
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ===========================================
# CHATGPT / OpenAI API
# ===========================================
# Get API key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4

# ===========================================
# LM STUDIO — Local OpenAI-compatible server (no API key)
# ===========================================
# Install: https://lmstudio.ai  |  Enable the "Local Server" (default port 1234).
# Set AI_PROVIDER=lmstudio to use it for chat. Base URL already includes /v1.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# ===========================================
# SERVER
# ===========================================
PORT=8081
# Empty for direct/local startup. Behind a proxy, list its exact IPs/subnets.
# Example: TRUSTED_PROXY_CIDRS=10.20.1.0/24,10.20.2.0/24
# Never use 0.0.0.0/0, ::/0, true, or an unverified hop count.
TRUSTED_PROXY_CIDRS=
NODE_ENV=development
SECURITY_TESTING_MODE=true
LAB_MODE=vuln   # vuln | fixed

# ===========================================
# AUTHENTICATION SECRETS  (REQUIRED — no fallback for SecureShop v2)
# ===========================================
# JWT_SECRET signs platform and SecureShop authentication tokens. `npm run setup`
# generates a private value; the sample below is intentionally rejected at startup.
# The SS v2 boot path refuses to start without it — no hardcoded default.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# SS_SESSION_TTL_SECONDS=14400 # Optional shop lifetime: integer 120–14400 seconds; default 4 hours.
# PLATFORM_SESSION_TTL_SECONDS=86400 # Optional cap: integer 120–86400 seconds; defaults remain 24 hours (login), 1 hour (secure-login).
# SS_ADMIN_JWT_SECRET (optional) — separate secret for the intentional
# alg=none teaching endpoint /api/secureshop/admin/whoami. Falls back to
# JWT_SECRET if unset (dev only).
# SS_ADMIN_JWT_SECRET=change_me_too

# ===========================================
# GMAIL SMTP (Email Agent workshop)
# ===========================================
# XSS defaults to the existing local Mailpit sidecar; gmail selects the external inbox workflow.
XSS_MAIL_PROVIDER=mailpit
# Gmail SMTP is required for the Email Agent challenge and XSS only when gmail is selected.
# Setup: https://myaccount.google.com/apppasswords (needs 2FA enabled first).
# See docs/install/SMTP_SETUP.md for detailed instructions.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Separate, opt-in SecureShop merchant external test-email flow.
# Sends only a reviewed synthetic plaintext message to one @sharklasers.com address.
# No fallback to the workshop GMAIL_* credentials; never commit private values.
SS_EXTERNAL_MAIL_ENABLED=false
SS_EXTERNAL_MAIL_GMAIL_USER=
SS_EXTERNAL_MAIL_GMAIL_APP_PASSWORD=
# IPI Email Agent provider: gmail (default) or local Mailpit (no external delivery).
IPI_EMAIL_PROVIDER=gmail
IPI_MAIL_DOMAIN=dvaia.invalid
IPI_MAIL_FROM=indirectpromptinjection@dvaia.invalid
# Required only when IPI_EMAIL_PROVIDER=mailpit; generate privately, never commit/log.
# IPI_MAIL_HMAC_SECRET=
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_API_URL=http://127.0.0.1:8025

# SecureShop v2 (M7 cutover — v2 is now the default SecureShop surface)
# Set to false only if you want to disable the Agent Host process for
# performance/isolation. The storefront REST endpoints depend on this
# router being mounted; keep true for normal operation.
SS_ENABLE=true
# Private installation key file for owned admin password-reset recovery.
# Supported setup provisions this file; never paste key material here or commit it.
SS_PASSWORD_RESET_KEY_PATH=
# Controlled teaching targets require their qualified schema/catalog migration
# and an absolute, private fixture directory. Keep disabled until those release
# prerequisites have been installed; these flags never enable student visibility.
SS_MCP_TRUST_READY=false
SS_CONTROLLED_SSRF_READY=false
# SS_MCP_TRUST_FIXTURE_ROOT=
# SS_CONTROLLED_SSRF_FIXTURE_ROOT=
# CORS allowlist shared by SecureShop and platform identity/admin/progress APIs.
# Comma-separated exact origins; hosted use needs its public HTTPS origin.
# Include 127.0.0.1 counterparts because development may serve there depending on
# how it is launched, which the browser treats as a distinct origin.
SS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:8081,http://localhost:8081
# Supported setup writes this complete private tuple after proving that the
# host's assigned IPv6 loopback listener is available. Do not publish the
# capability secret, substitute a DNS name, or configure only part of the tuple.
# SS_BOUND_UPLOAD_ASSETS_ENABLED=true
# SS_UPLOAD_ASSET_HOST=::1
# SS_UPLOAD_ASSET_PORT=<setup-selected-private-port>
# SS_UPLOAD_ASSET_PUBLIC_ORIGIN=http://[::1]:<same-port>
# SS_UPLOAD_ASSET_CAPABILITY_SECRET=<setup-generated-private-secret>
SS_AGENT_HOST_PORT=8082
SS_AGENT_MAX_STEPS=8
SS_AGENT_MAX_PARALLEL_TOOLS=4
SS_AGENT_SESSION_TOKEN_BUDGET=100000
# RAG embedding provider for the vector store:
#   auto (default) → try Ollama, then LM Studio, then a deterministic hash fallback
#   ollama | lmstudio | hash → force one path
# Optional vector-store model: install explicitly with `ollama pull nomic-embed-text`
# or configure an installed LM Studio embedding model. Startup does not pull it.
# This is separate from the Xenova document embedding model verified by setup.
SS_EMBED_PROVIDER=auto
SS_EMBED_MODEL=nomic-embed-text
# LM Studio embedding model identifier (falls back to SS_EMBED_MODEL).
SS_LMSTUDIO_EMBED_MODEL=nomic-embed-text
SS_EMBED_DIM=768
SS_VECTOR_INDEX_DIR=server/database/vector-indexes
# Optional absolute root shared by SecureShop HTTP and agent-host upload/download.
# For reviewed asset restore/cutover only; blank retains server/uploads/secureshop.
SECURESHOP_UPLOAD_ROOT=
SS_UPLOADS_DIR=server/uploads/secureshop
SS_ENABLE_REAL_MCP_SPAWN=false
SS_TRACE_TO_STDOUT=false

# Inventory needs no external sidecar. Once its checked-in qualification gate
# passes, it is selected automatically with canonical bound readiness. Explicit
# false opts out; true cannot bypass an unqualified gate.
# SS_BOUND_INVENTORY_ENABLED=false

# Optional launch-owned prompt policies remain disabled until the registered
# secureshop_agents 0027 migration is installed in the target store and the
# packaged strict renderer passes local readiness. Enable this only with SS_ENABLE=true, the private
# SS_BOUND_REVIEWS_ENABLED=true configuration, and both PostgreSQL engine flags.
SS_BOUND_PROMPT_POLICIES_ENABLED=false
# Explicit origin of the local sandbox-runner process when the backend flag is true.
SS_POLICY_RENDERER_BASE_URL=http://127.0.0.1:8090
# Set these in that sandbox-runner process/container as the matching local pair.
SECURESHOP_POLICY_RENDER_ENABLED=false
SECURESHOP_POLICY_RENDER_MAX_CONCURRENT=2
# Policy decisions use the existing SecureShop provider and LangGraph runtime;
# there are no separate LangChain or LangGraph API keys.

# Optional bound System config reads remain disabled until the secureshop_agents
# 0028/0029 migrations and an owned sandbox-runner config reader are installed.
# Enable only with SS_ENABLE=true, SS_BOUND_REVIEWS_ENABLED=true and both
# PostgreSQL engine flags. The bearer is private installation state: setup or an
# operator supplies it to both processes; never commit a value here.
SS_BOUND_SYSTEM_CONFIG_ENABLED=false
SS_SYSTEM_CONFIG_BASE_URL=http://127.0.0.1:8090
SS_SYSTEM_CONFIG_TOKEN=

# Optional owned diagnostic listener; requires agents migration 0030 and bound reviews.
# Keep disabled until the isolated listener has been provisioned and qualified.
SS_BOUND_SYSTEM_DIAGNOSTIC_ENABLED=false
SS_BOUND_SYSTEM_REBUILD_ENABLED=false
SS_SYSTEM_DIAGNOSTIC_BASE_URL=http://127.0.0.1:8091
SS_SYSTEM_DIAGNOSTIC_TOKEN=

# Optional private owned restart listener. This is a separate bounded target;
# never point it at a host shell or an application process tree.
SS_BOUND_SYSTEM_RESTART_ENABLED=false
SS_SYSTEM_RESTART_BASE_URL=http://127.0.0.1:8092
SS_SYSTEM_RESTART_TOKEN=

# PostgreSQL migration preview (application cutover still in progress).
# Set both engine flags together only for qualification of converted routes.
# Normal legacy startup still has unconverted stores. Do not point tests at data.
# PLATFORM_DATABASE_ENGINE=postgres
# WORKSHOP_DATABASE_ENGINE=postgres
# PG_TLS=require  # required for remote connections; local loopback may omit
# One backend:72 fully warmed runtime slots + bounded readiness headroom.
# Agent host reserves4 separately; default PostgreSQL100 leaves15 usable slots
# beyond backend ceiling78 + host4 (assuming3 reserved). Multiple replicas need
# an explicit aggregate connection plan; this is not a200-user load guarantee.
# PG_POOL_BUDGET=78
# Each pair targets a separate database with its own restricted roles.
# Runtime role names and required variables: npm run db:postgres:initialize -- --plan
# IDENTITY_DATABASE_URL=
# IDENTITY_MIGRATION_DATABASE_URL=
# SQL_WORKSHOP_DATABASE_URL=
# SQL_WORKSHOP_MIGRATION_DATABASE_URL=
# NOSQL_WORKSHOP_DATABASE_URL=
# NOSQL_WORKSHOP_MIGRATION_DATABASE_URL=
# XSS_WORKSHOP_DATABASE_URL=
# XSS_WORKSHOP_MIGRATION_DATABASE_URL=
# MCP_WORKSHOP_DATABASE_URL=
# MCP_WORKSHOP_MIGRATION_DATABASE_URL=
# Qualified owned MCP runtime remains off until identity 0050 and MCP 0004 are
# registered and installed, and the strict local runner profile is ready.
MCP_OWNED_RESOURCES_ENABLED=false
# MCP model stages share one bounded owner run; retries do not extend it.
# Decision/response maximum: 90000 each. Owner-run maximum: 290000.
# Keep defaults until the selected model's complete workflow is qualified.
MCP_DECISION_TIMEOUT_MS=30000
MCP_RESPONSE_TIMEOUT_MS=30000
MCP_RUN_TIMEOUT_MS=120000
# Recon Judge only: maximum 120000; needs remaining enclosing owner-run time.
# Stages and repair calls share that deadline; an explicit saved-evidence retry
# has one bounded owner run and does not refresh its deadline between calls.
MCP_RECON_JUDGE_TIMEOUT_MS=90000
# Metadata-only protected-operation recovery requires migration0097 and qualified runner image.
MCP_PROTECTED_RECOVERY_ENABLED=false
MCP_SUPPLY_CHAIN_ENABLED=false
MCP_INDIRECT_INJECTION_ENABLED=false
# Qualified CodeBot uses the same scoped-AppArmor runner but remains separately disabled.
CODEBOT_OWNED_EXECUTION_ENABLED=false
CODEBOT_SANDBOX_RUNNER_URL=http://127.0.0.1:8092
# MCP_OWNED_TARGET_URL=http://127.0.0.1:8090
# MCP_OWNED_TARGET_TOKEN=  # server-owned capability transport secret
# MCP_OWNED_TARGET_APPARMOR_PROFILE=dvaia-mcp-sandbox
# MCP_OWNED_TARGET_PORT=8092
# CSRF_WORKSHOP_DATABASE_URL=
# CSRF_WORKSHOP_MIGRATION_DATABASE_URL=
# HTML email/RAG summary only. Default 25000 ms; explicit 1000–55000 ms.
# This stage shares the unchanged 240000 ms CSRF owner budget and must finish
# before the qualification transport's separate 60000 ms per-call ceiling.
# CSRF_HTML_SUMMARY_TIMEOUT_MS=25000
# SUPPLY_CHAIN_WORKSHOP_DATABASE_URL=
# SUPPLY_CHAIN_WORKSHOP_MIGRATION_DATABASE_URL=
# FINFLOW_WORKSHOP_DATABASE_URL=
# FINFLOW_WORKSHOP_MIGRATION_DATABASE_URL=
# EXCESSIVE_AGENCY_DATABASE_URL=
# EXCESSIVE_AGENCY_MIGRATION_DATABASE_URL=
# CTF_DATABASE_URL=
# CTF_MIGRATION_DATABASE_URL=
# SecureShop native challenge stores (separate from platform identity):
# SECURESHOP_DATABASE_URL=
# SECURESHOP_MIGRATION_DATABASE_URL=
# SECURESHOP_AGENTS_DATABASE_URL=
# SECURESHOP_AGENTS_MIGRATION_DATABASE_URL=

# Isolated legacy challenge PostgreSQL stores (runtime and migration roles differ).
# LEGACY_CHALLENGE_DATABASE_URL=postgresql://dvaia_legacy_challenge_runtime:CHANGE_ME@localhost:5432/dvaia_legacy_challenge
# LEGACY_CHALLENGE_MIGRATION_DATABASE_URL=postgresql://dvaia_legacy_challenge_migration:CHANGE_ME@localhost:5432/dvaia_legacy_challenge
# Dedicated synthetic session-disclosure lab; never point these at identity or SQL-injection stores.
# SESSION_DISCLOSURE_DATABASE_URL=postgresql://dvaia_session_disclosure_runtime:CHANGE_ME@localhost:5432/dvaia_session_disclosure
# SESSION_DISCLOSURE_MIGRATION_DATABASE_URL=postgresql://dvaia_session_disclosure_migration:CHANGE_ME@localhost:5432/dvaia_session_disclosure
# Dedicated owner-bound review lab; never share the intentionally vulnerable commerce SQL database.
# SECURESHOP_REVIEW_DATABASE_URL=postgresql://dvaia_secureshop_review_runtime:CHANGE_ME@localhost:5432/dvaia_secureshop_review
# SECURESHOP_REVIEW_MIGRATION_DATABASE_URL=postgresql://dvaia_secureshop_review_migration:CHANGE_ME@localhost:5432/dvaia_secureshop_review
# SENSITIVE_LOOKUP_DATABASE_URL=postgresql://dvaia_sensitive_lookup_runtime:CHANGE_ME@localhost:5432/dvaia_sensitive_lookup
# SENSITIVE_LOOKUP_MIGRATION_DATABASE_URL=postgresql://dvaia_sensitive_lookup_migration:CHANGE_ME@localhost:5432/dvaia_sensitive_lookup
# Optional shared workshop entry barrier; separate from account authentication.
# Enabling requires a unique 12-256 byte password without surrounding whitespace.
EVENT_GATE_ENABLED=false
EVENT_GATE_PASSWORD=

# Optional absolute normalized root for generated Legacy Sensitive teaching files.
# Existing files are preserved; see docs/modernization/legacy-sensitive-file-root.md.
# LEGACY_SENSITIVE_FILES_ROOT=

# Bound audit summaries (pending UI qualification); artifact cleanup stays enabled.
SS_AUDIT_SUMMARY_ENABLED=false

# File/SSI canonical agent is enabled by default after schema readiness.
# Set false to disable this runtime; instructor catalog/objective toggles remain independent.
# LEGACY_SENSITIVE_CANONICAL_AGENT_ENABLED=false

# Separate short teaching-effect leases; included in the process pool budget.
PG_POOL_MAX_TEACHING=2

# Bound lab mail mounts by default only after its checked-in production release gate
# is qualified, with SecureShop bound reviews and canonical PostgreSQL prerequisites.
# Header construction is qualified but default-disabled: an instructor must enable
# its workshop and objective. The other three mail objectives remain unqualified.
# New actor/Judge calls require their configured capabilities; local model presence
# is probed, cloud configuration remains unprobed until execution. Saved history
# and terminal receipt recovery remain available during model outages.
# Set false to disable transport; true never bypasses a release gate. Readiness is
# transport/catalog admission; modelCapabilities reports exact configured models,
# bounded local reachability, or configured_unprobed cloud status (not health).
# SS_BOUND_MAIL_ENABLED=false

# Optional hosted LangChain/LangGraph tracing; not needed for local operation.
# Traces may include model inputs/outputs. Use synthetic lab data and a private key.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=dvaia-local
# LANGSMITH_ENDPOINT=

# Dedicated ordered CTF delivery credential (same CTF database; generated by setup).
# Ordinary CTF_DATABASE_URL remains read-only after reviewed authority activation.
CTF_DELIVERY_DATABASE_URL=
