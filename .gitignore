.yarn-integrity

# dotenv environment variables file
# Supported setup generates private root configuration; preserve it locally only.
/.env
/.env.upgrade
# Private installation/provider settings never belong in a release.
.env.*
!.env.example
.env.test
.env.development.local
.env.test.local
.env.production.local

