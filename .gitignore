# Legacy SQLite sidecars are local archives/fixtures, never repository data.
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Private preservation snapshots include historical databases and credentials.
# Keep this portable; .git/info/exclude does not accompany a new repository.
/tasks/main-workspace-preservation-2026-09-28/

# Local work journals and qualification evidence; portable test inputs live in tests/.
/tasks/
/client/tasks/cache/

# Local frontend qualification captures (retain on disk, never ship as source).
# Portable qualification inputs and their recorder remain eligible for release.
/tests/release-inputs/frontend-build-*/

# Python interpreter bytecode caches
__pycache__/
*.pyc

