{
  "name": "owasp-ai-goat",
  "version": "1.0.0",
  "description": "OWASP Agentic AI GOAT - An educational platform for learning AI agent and web security",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon --verbose server/index.js",
    "client": "npm --prefix client start",
    "build": "npm --prefix client run build",
    "setup": "node scripts/setup-application.js",
    "setup:mcp-owned": "node scripts/install/mcp-owned-provision.js",
    "start": "node server/index.js",
    "deploy:fresh": "node scripts/deploy-fresh.js init",
    "deploy:full": "node scripts/deploy-fresh.js full",
    "deploy:reset": "node scripts/deploy-fresh.js reset",
    "deploy:reset-full": "node scripts/deploy-fresh.js reset-full",
    "deploy:help": "node scripts/deploy-fresh.js help",
    "test": "npm run test:unit:isolated && npm run test:secureshop:isolated && npm run test:frontend",
    "verify": "npm run verify:secureshop",
    "db:initialize-all": "node db/postgres/initialize-application.js",
    "seed:vectors": "node scripts/seed-vectors.js",
    "seed:bulk": "node scripts/seed-bulk-data.js",
    "test:secureshop": "node --test --test-concurrency=1 'tests/secureshop/**/*.test.js'",
    "test:secureshop:unit": "node --test 'tests/secureshop/unit/**/*.test.js'",
    "test:secureshop:integration": "node --test --test-concurrency=1 'tests/secureshop/integration/**/*.test.js'",
    "test:secureshop:vuln": "node --test 'tests/secureshop/vuln/**/*.test.js'",
    "test:secureshop:chains": "node --test --test-concurrency=1 'tests/secureshop/vuln/chains/*.test.js'",
    "test:secureshop:parity": "node --test --test-concurrency=1 'tests/secureshop/vuln/parity/*.test.js'",
    "test:secureshop:e2e": "node --test --test-concurrency=1 --test-timeout=60000 'tests/secureshop/e2e/vuln-flows/*.test.js'",
    "test:secureshop:e2e:smoke": "node tests/secureshop/e2e/puppeteer-smoke.js",
    "docs:secureshop:vuln-map": "node scripts/generate-vuln-map.js",
    "verify:secureshop:schema": "node scripts/verify-secureshop-schema.js",
    "verify:secureshop:vuln-coverage": "node scripts/verify-secureshop-vuln-coverage.js",
    "verify:secureshop": "npm run verify:secureshop:schema && npm run verify:secureshop:vuln-coverage",
    "verify:learning-dependencies": "node scripts/verify-learning-dependencies.js",
    "test:modernization": "node --test tests/platformSessionValidity.test.js tests/platformAuditMetadata.test.js tests/authSessionHandlers.test.js tests/instructorStudentHandlers.test.js tests/learningDependencies.test.js tests/progressSyncReset.test.js tests/workshopGraph.test.js tests/postgres/foundation.test.js tests/secureshop/unit/providers/openaiFailures.test.js tests/workshopGraph.races.test.js tests/workshopRouteHandlers.test.js tests/workshopExperience.test.js tests/sessionManagerReview.test.js tests/applicationLifecycle.test.js tests/langchainProviders.test.js tests/modelScheduler.test.js",
    "test:ollama:8b": "node scripts/test-ollama-8b.js",
    "db:postgres:initialize": "node db/postgres/initialize-application.js",
    "db:postgres:migrate": "node db/postgres/migrate.js",
    "test:postgres": "node scripts/test-isolated.js postgres",
    "test:native-operator": "node scripts/test-isolated.js native-operator",
    "test:unit:isolated": "node scripts/test-isolated.js unit",
    "test:secureshop:isolated": "node scripts/test-isolated.js secureshop",
    "test:frontend": "npm --prefix client test -- --watchAll=false --runInBand",
    "test:api": "node tests/api.test.js",
    "verify:workshop:browser": "node scripts/verify-workshop-browser.cjs",
    "test:judge:8b": "node scripts/test-judge-8b.js",
    "db:postgres:provision": "node db/postgres/provision-application.js",
    "test:native-browser": "node scripts/test-native-browser.js",
    "test:admin-bundle": "node scripts/test-native-browser.js --admin-bundle"
  },
  "keywords": [
    "security",
    "education",
    "vulnerable",
    "ai",
    "web-security"
  ],
  "author": "OWASP Agentic AI GOAT contributors",
  "license": "GPL-3.0",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1146.0",
    "@huggingface/transformers": "4.3.0",
    "@langchain/anthropic": "1.5.12",
    "@langchain/aws": "1.4.6",
    "@langchain/core": "1.2.16",
    "@langchain/langgraph": "1.4.19",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.6.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "axios": "1.20.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "body-parser": "2.3.0",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "hnswlib-node": "^3.0.0",
    "jsonwebtoken": "9.0.3",
    "langchain": "1.5.15",
    "mammoth": "1.13.0",
    "marked": "18.1.0",
    "morgan": "1.12.1",
    "multer": "2.4.0",
    "mysql2": "3.24.5",
    "node-gyp": "13.1.0",
    "nodemailer": "10.0.15",
    "nunjucks": "3.2.4",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "puppeteer": "25.12.0",
    "sax": "1.6.1",
    "sqlite3": "6.0.1",
    "tar-stream": "3.2.2",
    "winston": "^3.19.0",
    "xml2js": "0.6.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "nodemon": "3.1.14"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true,
    "hnswlib-node@3.0.0": true,
    "protobufjs@7.6.6": true,
    "better-sqlite3@13.0.3": true,
    "sqlite3@6.0.1": true,
    "sharp@0.35.4": true,
    "onnxruntime-node@1.30.0": true,
    "puppeteer@25.12.0": true
  },
  "overrides": {
    "sharp": "0.35.4",
    "adm-zip": "0.6.1"
  }
}
