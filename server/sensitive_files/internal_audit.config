# ShopFast Internal Audit Configuration
# CONFIDENTIAL - SECURITY TEAM ONLY

[audit_service]
enabled=true
log_level=detailed
retention_days=730

[database_audit]
connection_string=postgresql://audit_admin:AuditSecure2024!@audit-db.shopfast.local:5432/audit_logs
schema=public
table_prefix=audit_

[admin_credentials]
audit_user=audit_admin
password=AuditSecure2024!
api_key=audit-api-key-ShopFast-internal-2024
service_token=svc-token-audit-system-prod

[alert_config]
fraud_threshold=5000
admin_email=security@shopfast.com
sms_gateway_key=SMS-GATEWAY-KEY-ShopFast-2024

[encryption]
algorithm=AES-256-GCM
master_key=MASTER-KEY-AES256-Audit-System-ShopFast
rotation_interval=90days
